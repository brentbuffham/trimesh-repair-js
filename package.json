{
	"name": "trimesh-repair-js",
	"version": "0.1.3",
	"description": "Repair functions for the trimesh family of JavaScript meshing libraries: find and patch open loops, fill gaps, close holes, repair folds, orient, and check a mesh (closed, non-manifold edges, enclosed volume).",
	"type": "module",
	"main": "./src/index.js",
	"exports": {
		".": "./src/index.js"
	},
	"files": [
		"src/",
		"LICENSE",
		"README.md"
	],
	"author": "Brent Buffham (https://kirra-design.com)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brentbuffham/trimesh-repair-js.git"
	},
	"bugs": {
		"url": "https://github.com/brentbuffham/trimesh-repair-js/issues"
	},
	"homepage": "https://github.com/brentbuffham/trimesh-repair-js#readme",
	"keywords": [
		"mesh",
		"mesh-repair",
		"hole-filling",
		"triangulation",
		"manifold",
		"trimesh",
		"mining"
	],
	"engines": {
		"node": ">=22"
	},
	"sideEffects": false,
	"scripts": {
		"test": "vitest run",
		"dev": "vite",
		"build:demo": "vite build"
	},
	"dependencies": {
		"trimesh-boolean": "^0.7.7"
	},
	"devDependencies": {
		"trimesh-build-js": "0.5.0",
		"las-laz-js": "^0.10.0",
		"vitest": "^3.2.4",
		"three": "^0.183.2",
		"vite": "^7.3.7"
	}
}
